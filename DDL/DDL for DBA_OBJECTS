-- ================================================================
-- Script Name : get_ddl.sql
-- Purpose     : Interactive DDL Extractor for Oracle Database
-- Description : Interactively select object type and owner to extract DDL
-- ================================================================

SET LINESIZE 200
SET LONG 999999
SET PAGESIZE 100
SET VERIFY OFF
COLUMN object_type FORMAT A20
COLUMN owner FORMAT A25
COLUMN object_name FORMAT A40

PROMPT
PROMPT ============================================================
PROMPT Step 1: Choose Object Type
PROMPT ============================================================

PROMPT Available Object Types:
PROMPT 1. TABLE
PROMPT 2. VIEW
PROMPT 3. INDEX
PROMPT 4. SEQUENCE
PROMPT 5. SYNONYM
PROMPT 6. PACKAGE
PROMPT 7. PROCEDURE
PROMPT 8. FUNCTION
PROMPT 9. TRIGGER
PROMPT 10. USER
PROMPT 11. MATERIALIZED VIEW
PROMPT 12. TYPE
PROMPT ============================================================

ACCEPT obj_type CHAR PROMPT 'Enter Object Type (e.g., TABLE, VIEW, USER, etc.): '

PROMPT
PROMPT ============================================================
PROMPT Step 2: Choose Owner
PROMPT ============================================================

SELECT DISTINCT owner 
FROM dba_objects 
WHERE object_type = UPPER('&obj_type')
ORDER BY owner;

PROMPT
ACCEPT obj_owner CHAR PROMPT 'Enter Owner from above list: '

PROMPT
PROMPT ============================================================
PROMPT Step 3: Choose Object Name
PROMPT ============================================================

SELECT object_name, object_type, status 
FROM dba_objects 
WHERE object_type = UPPER('&obj_type')
AND owner = UPPER('&obj_owner')
ORDER BY object_name;

PROMPT
ACCEPT obj_name CHAR PROMPT 'Enter Object Name from above list: '

PROMPT
PROMPT ============================================================
PROMPT Step 4: Generating DDL for &obj_owner..&obj_name (&obj_type)
PROMPT ============================================================

SELECT 
    DBMS_METADATA.GET_DDL(UPPER('&obj_type'), UPPER('&obj_name'), UPPER('&obj_owner')) AS ddl_script
FROM 
    dual;

PROMPT
PROMPT DDL extraction completed successfully.
PROMPT ============================================================
PROMPT Object Type : &obj_type
PROMPT Object Name : &obj_name
PROMPT Owner       : &obj_owner
PROMPT ============================================================

SET VERIFY ON
